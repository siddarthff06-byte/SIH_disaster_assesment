import numpy as np
import torch
from torchvision import transforms
from model_setup import get_model

def preprocess(img):
    transform = transforms.Compose([
        transforms.ToTensor(),
        transforms.Normalize(mean=[0.485, 0.456, 0.406],
                              std=[0.229, 0.224, 0.225]),
    ])
    return transform(img).unsqueeze(0)

if __name__ == "__main__":
    model = get_model()

    before_img = np.load("../data/processed/before.npy")
    after_img  = np.load("../data/processed/after.npy")

    with torch.no_grad():
        before_mask = torch.sigmoid(model(preprocess(before_img))) > 0.5
        after_mask  = torch.sigmoid(model(preprocess(after_img))) > 0.5

    before_mask = before_mask.squeeze().numpy()
    after_mask  = after_mask.squeeze().numpy()

    np.save("../outputs/masks/before_mask.npy", before_mask)
    np.save("../outputs/masks/after_mask.npy", after_mask)
    print("Day 1 target hit — masks saved to outputs/masks/")